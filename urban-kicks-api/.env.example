# ============================================================
# ARCHIVO: .env.example
# PROPÓSITO: Plantilla pública de variables de entorno.
#            Copia este archivo como ".env" y rellena tus valores reales.
# ============================================================

# Nombre del servidor SQL Server (ej. localhost o DESKTOP-XXXX\SQLEXPRESS)
DB_SERVER=localhost

# Nombre de la base de datos
DB_NAME=urban_kicks_db

# Usuario de SQL Server (si usas autenticación SQL)
DB_USER=tu_usuario

# Contraseña de SQL Server
DB_PASSWORD=tu_contraseña

# Driver de pyodbc instalado en tu máquina
# En Windows con SQL Server, suele ser: ODBC Driver 17 for SQL Server
DB_DRIVER=ODBC Driver 17 for SQL Server
