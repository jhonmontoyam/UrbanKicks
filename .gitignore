# ============================================================
# ARCHIVO: .gitignore
# PROPÓSITO: Especificar archivos y carpetas que Git DEBE IGNOAR
#            para no subir datos sensibles ni archivos temporales.
# ============================================================

# ------------------------------------------------------------
# 1. Archivos de Configuración y Claves de Entorno (¡SENSIBLE!)
# ------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example   # SÍ incluimos la plantilla de ejemplo

# ------------------------------------------------------------
# 2. Entornos Virtuales de Python
# ------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------
# 3. Archivos de Caché y Compilados de Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------
# 4. Configuraciones de Editores e IDEs
# ------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# 5. Archivos del Sistema Operativo
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# 6. Archivos de Registro y Base de Datos Local / Temporales
# ------------------------------------------------------------
*.log
*.sqlite
*.db
tmp/
temp/
